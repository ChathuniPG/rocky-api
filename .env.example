# Copy this file to .env and adjust the values for your machine.
# Every variable is validated at startup (src/config/env.validation.ts);
# the API refuses to start if a value is invalid.

# Runtime environment: development | production | test. Default: development.
NODE_ENV=development

# HTTP port the API listens on (1-65535). Default: 4000.
PORT=4000

# --- Local PostgreSQL (docker-compose.yml) -----------------------------------
# Read by Docker Compose only (not by the API). `npm run db:up` starts the database.
POSTGRES_USER=rocky
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rocky
# Host port, bound to 127.0.0.1 only. Default: 5432.
POSTGRES_PORT=5432

# PostgreSQL connection string used by the API and the Prisma CLI. Required.
# Must repeat the values above literally: .env files do not expand ${VARIABLES}.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://rocky:change-me@127.0.0.1:5432/rocky
