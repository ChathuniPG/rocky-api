# Copy this file to .env and adjust the values for your machine.
# Every variable is validated at startup (src/config/env.validation.ts);
# the API refuses to start if a value is invalid.

# Runtime environment: development | production | test. Default: development.
NODE_ENV=development

# HTTP port the API listens on (1-65535). Default: 4000.
PORT=4000

# Network interface the API listens on, as an IPv4 or IPv6 address. Default: 127.0.0.1.
# 127.0.0.1 accepts connections from this machine only: on the server, only Nginx can
# reach the API. 0.0.0.0 listens on all interfaces; use it only when that is required
# (e.g. inside a container) and the port is protected in another way.
HOST=127.0.0.1

# --- Local PostgreSQL (docker-compose.yml) -----------------------------------
# Read by Docker Compose only (not by the API). `npm run db:up` starts the database.
POSTGRES_USER=rocky
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rocky
# Host port, bound to 127.0.0.1 only. Default: 5432.
POSTGRES_PORT=5432

# PostgreSQL connection string used by the API and the Prisma CLI. Required.
# Must repeat the values above literally: .env files do not expand ${VARIABLES}.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://rocky:change-me@127.0.0.1:5432/rocky

# --- Firebase (ADR-002, ADR-011) ---------------------------------------------
# Absolute path to the Firebase Admin SDK service account key (JSON). Required.
# ADR-011: the key lives OUTSIDE the repository, never inside it. At startup the API
# checks that the file exists, is a service account key with project_id, client_email
# and private_key, and that its project_id equals FIREBASE_PROJECT_ID.
# Download: Firebase console > Project settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT_PATH=D:/AssessmentProjects/ROCKY/secrets/your-project-firebase-adminsdk.json

# Firebase project ID (Project settings > General). Required.
FIREBASE_PROJECT_ID=your-project-id

# Default Storage bucket name, without gs:// (Storage page in the console). Required.
# Usually <project-id>.firebasestorage.app (older projects: <project-id>.appspot.com).
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Web API key (Project settings > General > Web API key). Required. Used only by the
# API for the Auth REST sign-in and token-refresh calls. Treat it as a secret.
FIREBASE_WEB_API_KEY=your-web-api-key

# --- Auth cookies (ADR-003) ---------------------------------------------------
# Secure flag on the rocky_id and rocky_refresh cookies: true | false. Default: true.
# Must be true in production (the API refuses to start otherwise). Set false only for
# local development over plain http.
COOKIE_SECURE=false

# --- Demo data seed (npm run db:seed) -----------------------------------------
# Shared password of the six demo users (demo.<name>@example.com). Optional: the API
# never reads it, only the seed script, which refuses to run without it. Must meet the
# sign-up rules: 8-128 characters with at least one letter and one digit. Never logged.
SEED_DEMO_PASSWORD=change-me-demo-1
