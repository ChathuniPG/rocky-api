// R.O.C.K.Y. data model. Source of truth: docs/design.md, Section 4 (ADR-001: Prisma).
//
// Conventions used throughout (design.md §4.1):
// - Primary keys are UUIDs generated by PostgreSQL (gen_random_uuid), so they are not
//   guessable or enumerable.
// - Tables and columns are snake_case in the database (@map / @@map) and camelCase in code.
// - Every timestamp is timestamptz. updated_at also has a database default, so rows
//   inserted with raw SQL are valid; Prisma itself sets it on every update (@updatedAt).
// - Every relation uses ON DELETE CASCADE.
// - PostgreSQL does not index foreign key columns automatically, so each FK is the leading
//   column of at least one index (or of the primary key / a unique constraint).
//
// Index direction: every list query orders by (created_at DESC, id DESC), where id breaks
// ties for the pagination cursor (ADR-005); the conversation list uses
// (last_message_at DESC, id DESC) instead. PostgreSQL can scan a B-tree index backwards,
// so plain ascending indexes on exactly those columns serve the DESC order without a sort.
//
// Timestamp precision: timestamps that are pagination cursors (created_at of posts,
// comments, likes, saves, notifications and messages; conversations.last_message_at) are
// timestamptz(3), milliseconds. A JS Date, and therefore the cursor, only holds
// milliseconds; with microsecond values, rows in the same millisecond as a cursor row
// would match neither `ts < c` nor `ts = c` and be silently skipped (ADR-005). Other
// timestamps keep (6).
//
// CHECK constraints (non-negative counters, no self-follow, conversation user ordering,
// non-blank bodies, username pattern) cannot be expressed in Prisma Schema Language. They
// are written by hand in the initial migration SQL. Prisma does not track CHECK
// constraints, so later migrations neither recreate nor drop them.

generator client {
  provider     = "prisma-client"
  // Generated inside src/ so `nest build` compiles it with the app. Not committed (.gitignore);
  // regenerated by `npm install` (postinstall) and `npm run prisma:generate`.
  output       = "../src/generated/prisma"
  // The app is CommonJS (tsconfig "nodenext" without "type": "module").
  moduleFormat        = "cjs"
  // Extensionless relative imports ("./enums" instead of "./enums.js"), matching the rest of
  // the codebase. Jest resolves these directly, without mapping ".js" back to ".ts".
  importFileExtension = ""
}

datasource db {
  // The connection URL lives in prisma.config.ts (Prisma 7).
  provider = "postgresql"
}

enum MediaType {
  IMAGE
  VIDEO

  @@map("media_type")
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW

  @@map("notification_type")
}

model User {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebaseUid          String   @unique @map("firebase_uid") @db.VarChar(128)
  email                String   @unique @db.VarChar(255)
  // Lowercase pattern ^[a-z0-9_.]{3,30}$ is enforced by a CHECK constraint (see migration).
  username             String   @unique @db.VarChar(30)
  displayName          String   @map("display_name") @db.VarChar(50)
  bio                  String?  @db.VarChar(160)
  avatarUrl            String?  @map("avatar_url")
  // Firebase Storage object path of the current avatar, kept so the server can delete the
  // object when the avatar is replaced or removed (FR-PROF-04). Never returned to clients.
  avatarPath           String?  @map("avatar_path")
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  language             String   @default("en") @db.VarChar(5)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  posts                  Post[]
  comments               Comment[]
  likes                  Like[]
  saves                  Save[]
  following              Follow[]       @relation("FollowFollower")
  followers              Follow[]       @relation("FollowFollowing")
  notificationsReceived  Notification[] @relation("NotificationRecipient")
  notificationsTriggered Notification[] @relation("NotificationActor")
  conversationsAsUserA   Conversation[] @relation("ConversationUserA")
  conversationsAsUserB   Conversation[] @relation("ConversationUserB")
  messagesSent           Message[]

  @@map("users")
}

model Post {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId     String    @map("author_id") @db.Uuid
  caption      String    @default("") @db.VarChar(2200)
  mediaUrl     String    @map("media_url")
  // Firebase Storage object path, kept so the file can be deleted with the post (ADR-007).
  // Unique: one upload backs at most one post, so deleting a post can never delete the
  // media of another one.
  mediaPath    String    @unique @map("media_path")
  mediaType    MediaType @map("media_type")
  // ADR-006: denormalised counters, updated in the same transaction as the like/comment.
  // CHECK (>= 0) constraints in the migration guard against a counter going negative.
  likeCount    Int       @default(0) @map("like_count")
  commentCount Int       @default(0) @map("comment_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments      Comment[]
  likes         Like[]
  saves         Save[]
  notifications Notification[]

  // Profile grid: a user's posts, newest first. Also covers the author_id foreign key.
  @@index([authorId, createdAt, id])
  // Home feed: all posts, newest first (ADR-005 cursor).
  @@index([createdAt, id])
  @@map("posts")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  // Must contain a non-whitespace character: CHECK constraint in the migration.
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  // Comments of a post in cursor order. Also covers the post_id foreign key.
  @@index([postId, createdAt, id])
  @@index([authorId])
  @@map("comments")
}

// The composite primary key makes a duplicate like impossible at the database level.
model Like {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  // The primary key leads with user_id, so post_id needs its own index.
  @@id([userId, postId])
  @@index([postId])
  @@map("likes")
}

// Same structure as Like: the composite primary key prevents duplicate saves.
model Save {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  // Saved-posts tab: a user's saves, newest first. post_id is the cursor tie-breaker
  // (saves have no id column), so it is the last index column (ADR-005).
  @@index([userId, createdAt, postId])
  @@map("saves")
}

// Self-referencing many-to-many between users. A CHECK constraint in the migration
// prevents following yourself.
model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  // The primary key prevents duplicate follows and covers follower_id.
  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  actorId     String           @map("actor_id") @db.Uuid
  type        NotificationType
  // Set for LIKE and COMMENT notifications, null for FOLLOW.
  postId      String?          @map("post_id") @db.Uuid
  // Set for COMMENT notifications only.
  commentId   String?          @map("comment_id") @db.Uuid
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  // Cascades too: a notification about a deleted post or comment has nothing to link to.
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // Notification list, newest first. Also covers the recipient_id foreign key.
  @@index([recipientId, createdAt, id])
  // Unread badge count.
  @@index([recipientId, isRead])
  @@index([actorId])
  @@index([postId])
  @@index([commentId])
  @@map("notifications")
}

// One-to-one conversations only. The two participants are always stored in order
// (user_a_id < user_b_id, CHECK constraint in the migration). Together with the unique
// constraint, this allows only one conversation between any two users.
model Conversation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAId       String    @map("user_a_id") @db.Uuid
  userBId       String    @map("user_b_id") @db.Uuid
  // Inbox sort key and pagination cursor: the creation time until the first message, then
  // the latest message's created_at. Never null, so the keyset comparison is total.
  lastMessageAt DateTime  @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  // Also covers the user_a_id foreign key.
  @@unique([userAId, userBId])
  // The inbox query is "user_a_id = me OR user_b_id = me" ordered by (last_message_at, id):
  // one index per side. The second also covers the user_b_id foreign key.
  @@index([userAId, lastMessageAt, id])
  @@index([userBId, lastMessageAt, id])
  @@map("conversations")
}

model Message {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  // Must contain a non-whitespace character: CHECK constraint in the migration.
  body           String    @db.VarChar(1000)
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Messages of a conversation in cursor order. Also covers the conversation_id foreign key.
  @@index([conversationId, createdAt, id])
  @@index([senderId])
  @@map("messages")
}
